<?xml version="1.0" ?>
<xliff version="1.1" xmlns="urn:oasis:names:tc:xliff:document:1.1">
  <file datatype="php" original="contao/languages/en/tl_settings.xlf" source-language="en">
    <body>
      <trans-unit id="tl_settings.hostily_captcha_legend">
        <source>hostily Captcha</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaSiteKey.0">
        <source>Site key</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaSiteKey.1">
        <source>The public key of your project at captcha.hostily.de. Without site key and secret nothing is protected and nothing is blocked.</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaSecret.0">
        <source>Secret</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaSecret.1">
        <source>The secret key of your project. It stays on the server and is never written into a page.</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaServiceUrl.0">
        <source>Service URL</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaServiceUrl.1">
        <source>Default: https://captcha.hostily.de (leave empty), or the address of your own installation.</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaMode.0">
        <source>Mode</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaMode.1">
        <source>Visible shows a checkbox, invisible solves the check when the form is submitted. Press and hold and Slider always also offer the alternative &quot;Confirm with a click&quot;. &quot;As in the customer portal&quot; uses the setting of your project at captcha.hostily.de.</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaModes.portal">
        <source>as in the customer portal</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaModes.sichtbar">
        <source>visible</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaModes.unsichtbar">
        <source>invisible</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaModes.halten">
        <source>press and hold</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaModes.schieben">
        <source>slider</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaHoldTime.0">
        <source>Hold time (ms)</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaHoldTime.1">
        <source>800 to 3000 milliseconds, only for the mode Press and hold. Empty: default of the widget (1500).</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaLanguage.0">
        <source>Widget language</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaLanguage.1">
        <source>Automatic uses the language of the page (German or English, otherwise the widget decides).</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaLanguages.auto">
        <source>automatic (language of the page)</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaLanguages.de">
        <source>German</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaLanguages.en">
        <source>English</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaOnError.0">
        <source>If the service fails</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaOnError.1">
        <source>Also applies to a wrong secret. Every failure is written to the system log.</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaOnErrors.pass">
        <source>let submissions pass (default)</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaOnErrors.block">
        <source>block submissions</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaReplace.0">
        <source>Replace the built-in captcha</source>
      </trans-unit>
      <trans-unit id="tl_settings.hostilyCaptchaReplace.1">
        <source>Uses hostily Captcha wherever Contao itself asks for its captcha (member registration, lost password, comments, form fields of type "Captcha").</source>
      </trans-unit>
    </body>
  </file>
</xliff>
